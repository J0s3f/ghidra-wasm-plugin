## Memory Instructions
## @@MM: multi-memory memarg (core spec, binary/instructions.html#binary-memarg):
##   memarg ::= align:u32 offset:u64                  if align < 2^6
##            | flags:u32 memidx:u32 offset:u64       if 2^6 <= flags < 2^7
## i.e. bit 6 of the *value* of the alignment field marks a memory index that precedes
## the offset. The u32 LEB rules allow non-minimal (padded) encodings of any value, so
## BOTH forms exist in every length a u32 LEB permits (1..5 bytes):
##   unflagged align: the decoded value keeps bit 6 clear, i.e. the FIRST byte has
##                    mflag = 0 (its low 7 bits are value bits 0..6);
##   flagged  flags:  the decoded value is 64..127 (bit 6 set, bits 7+ clear), i.e. the
##                    FIRST byte has mflag = 1 and every following byte pads with zero
##                    chunks (0x80 ... 0x00).
## The two families are disjoint on the first byte's mflag, so the match is exact; the
## exported val is the alignment *without* the flag in both forms. A multi-byte value
## with bit 6 set and a non-zero higher chunk (>= 128) is spec-invalid (the spec allows
## flags only in 64..127) and matches neither family.
##
## align, no memory index: single byte, bit 6 clear (align 0..63 - all real alignments)
memalign: "align="^val is topbit = 0 & mflag = 0 & v0
	[ val = (0 | v0); ]
{ export *[const]:8 val; }

## ... or a multi-byte LEB (non-minimal align encodings; a u32 needs at most 5 bytes).
## The decoded value must keep bit 6 clear, i.e. the FIRST byte has mflag = 0: a padded
## encoding of a flagged value (64..127) belongs to memalign_mem below, not here.
memalign: "align="^val is topbit = 1 & mflag = 0 & v0; topbit = 0 & v1
	[ val = (0 | v0 | ( v1 << 7 )); ]
{ export *[const]:8 val; }

memalign: "align="^val is topbit = 1 & mflag = 0 & v0; topbit = 1 & v1; topbit = 0 & v2
	[ val = (0 | v0 | ( v1 << 7 ) | ( v2 << 14 )); ]
{ export *[const]:8 val; }

memalign: "align="^val is topbit = 1 & mflag = 0 & v0; topbit = 1 & v1; topbit = 1 & v2; topbit = 0 & v3
	[ val = (0 | v0 | ( v1 << 7 ) | ( v2 << 14 ) | ( v3 << 21 )); ]
{ export *[const]:8 val; }

memalign: "align="^val is topbit = 1 & mflag = 0 & v0; topbit = 1 & v1; topbit = 1 & v2; topbit = 1 & v3; topbit = 0 & v4
	[ val = (0 | v0 | ( v1 << 7 ) | ( v2 << 14 ) | ( v3 << 21 ) | ( v4 << 28 )); ]
{ export *[const]:8 val; }

## align with a memory index (flagged value 64..127: bit 6 set, bits 7+ clear). Single
## byte 0x40..0x7f, or the same value padded to 2..5 bytes (first byte 0xc0..0xff, then
## zero chunks); v0 is the first byte's low 7 bits = 0x40 | mlow, so val = v0 & 0x3f is
## the alignment without the flag, exactly as in the single-byte form.
memalign_mem: "align="^val is mflag = 1 & topbit = 0 & mlow
	[ val = (0 | mlow); ]
{ export *[const]:8 val; }

memalign_mem: "align="^val is topbit = 1 & mflag = 1 & v0; topbit = 0 & v1 = 0
	[ val = (0 | ( v0 & 0x3f )); ]
{ export *[const]:8 val; }

memalign_mem: "align="^val is topbit = 1 & mflag = 1 & v0; topbit = 1 & v1 = 0; topbit = 0 & v2 = 0
	[ val = (0 | ( v0 & 0x3f )); ]
{ export *[const]:8 val; }

memalign_mem: "align="^val is topbit = 1 & mflag = 1 & v0; topbit = 1 & v1 = 0; topbit = 1 & v2 = 0; topbit = 0 & v3 = 0
	[ val = (0 | ( v0 & 0x3f )); ]
{ export *[const]:8 val; }

memalign_mem: "align="^val is topbit = 1 & mflag = 1 & v0; topbit = 1 & v1 = 0; topbit = 1 & v2 = 0; topbit = 1 & v3 = 0; topbit = 0 & v4 = 0
	[ val = (0 | ( v0 & 0x3f )); ]
{ export *[const]:8 val; }

memoffset: "offset="^ULeb128 is ULeb128 {
	export ULeb128;
}

## @@MM: linear memory N is addressed at N * MEMORY_STRIDE in the dedicated `memory`
## address space (memory 0 => offset 0, unchanged; see @define MEMORY_STRIDE in
## WebAssembly.sinc and WasmLoader.MEMORY_STRIDE). The `memory` space is 32-bit (size=4),
## so memory index >= 8 no longer collides with the module image in `ram` at CODE_BASE.
## All 32-bit memory address arithmetic stays in 32 bits (addr:4) — no ZEXT in the C.
##
## @@M64: a 64-bit-indexed memory (memory64) takes an i64 address operand and a u64 offset.
## The address is computed in 64 bits in the `memory64` space. The 32-bit path stays
## unchanged. The two variants are selected by ctx_mem64, which the Java pre-analyzer
## sets per instruction from the memory's declared index type (it is not encoded in the
## byte stream).
loadaddr: memalign memoffset is memalign; memoffset; ctx_mem64=0; sp1_32 {
	addr:4 = memoffset:4 + sp1_32;
	export addr;
}

loadaddr: memalign_mem memidx_label memoffset is memalign_mem; memidx_label; memoffset; ctx_mem64=0; sp1_32 {
	addr:4 = memoffset:4 + sp1_32 + memidx_label:4 * $(MEMORY_STRIDE);
	export addr;
}

loadaddr64: memalign memoffset " (i64 index)" is memalign; memoffset; ctx_mem64=3; sp1_64 {
	addr:8 = memoffset:8 + sp1_64;
	export addr;
}

loadaddr64: memalign_mem memidx_label memoffset " (i64 index)" is memalign_mem; memidx_label; memoffset; ctx_mem64=3; sp1_64 {
	addr:8 = memoffset:8 + sp1_64 + memidx_label:8 * $(MEMORY_STRIDE);
	export addr;
}

storeaddr: memalign memoffset is memalign; memoffset; ctx_mem64=0; sp2_32 {
	addr:4 = memoffset:4 + sp2_32;
	export addr;
}

storeaddr: memalign_mem memidx_label memoffset is memalign_mem; memidx_label; memoffset; ctx_mem64=0; sp2_32 {
	addr:4 = memoffset:4 + sp2_32 + memidx_label:4 * $(MEMORY_STRIDE);
	export addr;
}

## @@M64: see the loadaddr note above.
storeaddr64: memalign memoffset " (i64 index)" is memalign; memoffset; ctx_mem64=3; sp2_64 {
	addr:8 = memoffset:8 + sp2_64;
	export addr;
}

storeaddr64: memalign_mem memidx_label memoffset " (i64 index)" is memalign_mem; memidx_label; memoffset; ctx_mem64=3; sp2_64 {
	addr:8 = memoffset:8 + sp2_64 + memidx_label:8 * $(MEMORY_STRIDE);
	export addr;
}

