# sleigh include file for WebAssembly language instructions

define token opbyte (8)
	opc = (0, 7)
	valtype = (0, 7)
	bytev = (0, 7)

	topbit = (7, 7)
	v0 = (0, 6)
	v1 = (0, 6)
	v2 = (0, 6)
	v3 = (0, 6)
	v4 = (0, 6)
	v5 = (0, 6)
	v6 = (0, 6)
	v7 = (0, 6)
	v8 = (0, 6)
	v9 = (0, 6)
	# @@MM: multi-memory memarg flag: bit 6 of the alignment field's value marks a
	# following memidx. mlow is the alignment value *without* the flag.
	mflag = (6, 6)
	mlow = (0, 5)
;

define token I32 (32)
	f32 = (0,31)
;

define token I64 (64)
	f64 = (0,63)
;

# @@MM: multi-memory. Linear memory N is addressed at offset N * MEMORY_STRIDE in the
# `memory` (i32) or `memory64` (i64) address space, in the memarg decoders and loader
# (WasmLoader.getMemoryAddress / WasmLoader.MEMORY_STRIDE - keep the two in sync).
# Memory 0 therefore keeps its old offset 0. The `memory` space is 32-bit (size=4),
# so the stride is chosen so that many memory indices fit: with 128 MiB per memory,
# indices 0..31 fit in 32 bits (memory 31 = 0xF8000000), and memory index >= 8 no
# longer collides with the module image in `ram` at WasmLoader.CODE_BASE (0x80000000).
# All 32-bit memory address arithmetic stays in 32 bits (addr:4), so the decompiled C
# has no ZEXT noise. The separate memory64 path preserves 64-bit effective addresses.
@define MEMORY_STRIDE 0x08000000

attach names valtype [
  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ # 0x0
  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ # 0x10
  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ # 0x20
  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ # 0x30
  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ # 0x40
  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ # 0x50
  _ _ _ _ _ _ _ _ _ exnref arrayref structref i31ref eqref anyref externref # 0x60  # @@EH/@@GC: 0x69 exnref, 0x6a-0x6e GC heap-type shorthands
  funcref none noextern nofunc noexn _ _ _ _ _ _ v128 f64 f32 i64 i32 # 0x70  # @@GC: 0x71-0x74 bottom heap types
  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ # 0x80
  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ # 0x90
  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ # 0xa0
  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ # 0xb0
  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ # 0xc0
  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ # 0xd0
  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ # 0xe0
  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ # 0xf0
];

################################################################

define pcodeop funcEntryCallOther;
define pcodeop popCallOther;
define pcodeop pushCallOther;
define pcodeop callPrologueCallOther;
define pcodeop callEpilogueCallOther;
define pcodeop halt_trap;
define pcodeop popcnt;
define pcodeop clz;
define pcodeop ctz;
# TODO: define some of these in terms of a more generic "memcpy"/"memset" operation
define pcodeop table_init;
define pcodeop elem_drop;
define pcodeop table_copy;
define pcodeop table_grow;
define pcodeop table_size;
define pcodeop table_fill;
define pcodeop memory_size;
define pcodeop memory_grow;
define pcodeop memory_init;
define pcodeop data_drop;
define pcodeop memory_copy;
define pcodeop memory_fill;
# Legacy exception handling and threads (added for wasm-ghidra; not in upstream at 4708d290)
define pcodeop wasm_exception_caught;
define pcodeop wasm_exception_payload;
define pcodeop wasm_throw;
define pcodeop wasm_rethrow;
define pcodeop memory_atomic_notify;
define pcodeop memory_atomic_wait32;
define pcodeop memory_atomic_wait64;
define pcodeop memcpy;
define pcodeop wasm_memory_copy;

@include "Leb128.sinc"

# This is a silly hack because I couldn't work out how to use Leb128 itself
# in the disassembly actions section of another constructor...
# NOTE: Recursive expansion doesn't seem to work, so we hardcode REG_SIZE and REG_LOCALS_BASE here.
@define SYMBOL local4
@define DEST_EXPR "0x10000000 + 16 * "
@define EXPORT_EXPR "export *[register]:4 dest;"
@include "Leb128_u32.sinc"

@define SYMBOL local8
@define DEST_EXPR "0x10000000 + 16 * "
@define EXPORT_EXPR "export *[register]:8 dest;"
@include "Leb128_u32.sinc"

@define SYMBOL local16
@define DEST_EXPR "0x10000000 + 16 * "
@define EXPORT_EXPR "export *[register]:16 dest;"
@include "Leb128_u32.sinc"

@define SYMBOL global4
@define DEST_EXPR "16 * "
@define EXPORT_EXPR "export *[global]:4 dest;"
@include "Leb128_u32.sinc"

@define SYMBOL global8
@define DEST_EXPR "16 * "
@define EXPORT_EXPR "export *[global]:8 dest;"
@include "Leb128_u32.sinc"

@define SYMBOL global16
@define DEST_EXPR "16 * "
@define EXPORT_EXPR "export *[global]:16 dest;"
@include "Leb128_u32.sinc"

@define SYMBOL tableref
@define DEST_EXPR "(1<<32) * "
@define EXPORT_EXPR "export *[table]:4 dest;"
@include "Leb128_u32.sinc"

@include "Leb128_opc2.sinc"

sp0_32: tmp_sp is ctx_sp [tmp_sp = $(REG_STACK_BASE) + (ctx_sp - 0) * $(REG_SIZE);] {
	export *[register]:4 tmp_sp;
}

sp0_64: tmp_sp is ctx_sp [tmp_sp = $(REG_STACK_BASE) + (ctx_sp - 0) * $(REG_SIZE);] {
	export *[register]:8 tmp_sp;
}

sp0_128: tmp_sp is ctx_sp [tmp_sp = $(REG_STACK_BASE) + (ctx_sp - 0) * $(REG_SIZE);] {
	export *[register]:16 tmp_sp;
}

sp1_32: tmp_sp is ctx_sp [tmp_sp = $(REG_STACK_BASE) + (ctx_sp - 1) * $(REG_SIZE);] {
	export *[register]:4 tmp_sp;
}

sp1_64: tmp_sp is ctx_sp [tmp_sp = $(REG_STACK_BASE) + (ctx_sp - 1) * $(REG_SIZE);] {
	export *[register]:8 tmp_sp;
}

sp1_128: tmp_sp is ctx_sp [tmp_sp = $(REG_STACK_BASE) + (ctx_sp - 1) * $(REG_SIZE);] {
	export *[register]:16 tmp_sp;
}

sp2_32: tmp_sp is ctx_sp [tmp_sp = $(REG_STACK_BASE) + (ctx_sp - 2) * $(REG_SIZE);] {
	export *[register]:4 tmp_sp;
}

sp2_64: tmp_sp is ctx_sp [tmp_sp = $(REG_STACK_BASE) + (ctx_sp - 2) * $(REG_SIZE);] {
	export *[register]:8 tmp_sp;
}

sp2_128: tmp_sp is ctx_sp [tmp_sp = $(REG_STACK_BASE) + (ctx_sp - 2) * $(REG_SIZE);] {
	export *[register]:16 tmp_sp;
}

sp3_32: tmp_sp is ctx_sp [tmp_sp = $(REG_STACK_BASE) + (ctx_sp - 3) * $(REG_SIZE);] {
	export *[register]:4 tmp_sp;
}

sp3_64: tmp_sp is ctx_sp [tmp_sp = $(REG_STACK_BASE) + (ctx_sp - 3) * $(REG_SIZE);] {
	export *[register]:8 tmp_sp;
}

sp3_128: tmp_sp is ctx_sp [tmp_sp = $(REG_STACK_BASE) + (ctx_sp - 3) * $(REG_SIZE);] {
	export *[register]:16 tmp_sp;
}

# @@STR: the widest string instruction (stringview_wtf8.encode_*) pops four values.
sp4_32: tmp_sp is ctx_sp [tmp_sp = $(REG_STACK_BASE) + (ctx_sp - 4) * $(REG_SIZE);] {
	export *[register]:4 tmp_sp;
}

sp4_64: tmp_sp is ctx_sp [tmp_sp = $(REG_STACK_BASE) + (ctx_sp - 4) * $(REG_SIZE);] {
	export *[register]:8 tmp_sp;
}

br_target: ctx_br_target is ctx_br_target {
	export *[ram]:4 ctx_br_target;
}

funcidx: ULeb128 is ULeb128 {
	export ULeb128;
}

typeidx: ULeb128 is ULeb128 {
	export ULeb128;
}

# @@UNIMP: tag index used by the stack-switching opcodes (suspend/switch), and a second
# type index for cont.bind. (A SLEIGH pattern cannot name one sub-constructor twice, and
# `typeidx2` from GCOps.sinc is not visible here because that file is included later.)
tagidx: ULeb128 is ULeb128 {
	export ULeb128;
}

typeidx2u: ULeb128 is ULeb128 {
	export ULeb128;
}

elemidx: ULeb128 is ULeb128 {
	export ULeb128;
}

tableidx: ULeb128 is ULeb128 {
	export ULeb128;
}

tableidx2: ULeb128 is ULeb128 {
	export ULeb128;
}

dataidx: ULeb128 is ULeb128 {
	export ULeb128;
}

memidx: ULeb128 is ULeb128 {
	export ULeb128;
}

memidx2: ULeb128 is ULeb128 {
	export ULeb128;
}

# @@MM: a memidx that prints its own value (used by the memarg-with-memidx form and the
# unimplemented 0xFB/0xFC instructions below).
memidx_label: "memidx="^ULeb128 is ULeb128 {
	export ULeb128;
}

count: ULeb128 is ULeb128 {
	export ULeb128;
}

# An explicit no-op operation, to be used before
# callother instructions to work around Ghidra issue #3390
# (which causes incorrect decompilation if the first pcodeop
# in a branch target instruction is a callother)
macro nop() {
	LR = LR;
}

macro trap() {
<trap_loop>
	halt_trap();
	goto <trap_loop>;
}

macro doBranch(br_target) {
	nop();
	popCallOther(&t0);
	pushCallOther(&t0);
	goto br_target;
}

################################################################

## Locals directives at the start of the function
:.locals is count; ctx_is_directive=1; ctx_directive_type=$(DIRECTIVE_LOCALS) {
	nop();
	funcEntryCallOther(&i0, &l0);
}

:.local "count="^count "type="^typeidx is count; typeidx; ctx_is_directive=1; ctx_directive_type=$(DIRECTIVE_LOCAL) {
}

local_reftype: "ref null "^SLeb128 is bytev=0x63; SLeb128 { }
local_reftype: "ref "^SLeb128 is bytev=0x64; SLeb128 { }
local_count1: value is topbit=0 & v0 [ value = (v0 << 0); ] { export *[const]:8 value; }
:.local "count="^local_count1 "type="^local_reftype is local_count1; local_reftype; ctx_is_directive=1; ctx_directive_type=$(DIRECTIVE_LOCAL) { }
local_count2: value is topbit=1 & v0; topbit=0 & v1 [ value = (v0 << 0) | (v1 << 7); ] { export *[const]:8 value; }
:.local "count="^local_count2 "type="^local_reftype is local_count2; local_reftype; ctx_is_directive=1; ctx_directive_type=$(DIRECTIVE_LOCAL) { }
local_count3: value is topbit=1 & v0; topbit=1 & v1; topbit=0 & v2 [ value = (v0 << 0) | (v1 << 7) | (v2 << 14); ] { export *[const]:8 value; }
:.local "count="^local_count3 "type="^local_reftype is local_count3; local_reftype; ctx_is_directive=1; ctx_directive_type=$(DIRECTIVE_LOCAL) { }
local_count4: value is topbit=1 & v0; topbit=1 & v1; topbit=1 & v2; topbit=0 & v3 [ value = (v0 << 0) | (v1 << 7) | (v2 << 14) | (v3 << 21); ] { export *[const]:8 value; }
:.local "count="^local_count4 "type="^local_reftype is local_count4; local_reftype; ctx_is_directive=1; ctx_directive_type=$(DIRECTIVE_LOCAL) { }
local_count5: value is topbit=1 & v0; topbit=1 & v1; topbit=1 & v2; topbit=1 & v3; topbit=0 & v4 [ value = (v0 << 0) | (v1 << 7) | (v2 << 14) | (v3 << 21) | (v4 << 28); ] { export *[const]:8 value; }
:.local "count="^local_count5 "type="^local_reftype is local_count5; local_reftype; ctx_is_directive=1; ctx_directive_type=$(DIRECTIVE_LOCAL) { }

## Control instructions
:unreachable is opc=0x00; ctx_is_directive=0 {
	trap();
}

:nop is opc=0x01; ctx_is_directive=0 {
}

:block "blocktype="^ULeb128 is opc=0x02; ULeb128; ctx_is_directive=0 {
}
:loop "blocktype="^ULeb128 is opc=0x03; ULeb128; ctx_is_directive=0 {
}
:if "blocktype="^ULeb128 is opc=0x04; ULeb128; br_target; sp1_32; ctx_is_directive=0 {
	if(sp1_32 != 0) goto inst_next;
	doBranch(br_target);
}

# @@FR/@@GC: a block type may also be a multi-byte (ref null ht) / (ref ht) value type
# (0x63/0x64 followed by the s33 heaptype). The plain ULeb128 forms above consume only the
# first byte, which desynchronises the rest of the body, so add the explicit multi-byte forms.
multi_blocktype: SLeb128 is bytev=0x63; SLeb128 {
	export SLeb128;
}
multi_blocktype: SLeb128 is bytev=0x64; SLeb128 {
	export SLeb128;
}

:block "blocktype="^multi_blocktype is opc=0x02; multi_blocktype; ctx_is_directive=0 {
}
:loop "blocktype="^multi_blocktype is opc=0x03; multi_blocktype; ctx_is_directive=0 {
}
:if "blocktype="^multi_blocktype is opc=0x04; multi_blocktype; br_target; sp1_32; ctx_is_directive=0 {
	if(sp1_32 != 0) goto inst_next;
	doBranch(br_target);
}
:else is opc=0x05; br_target; ctx_is_directive=0 {
	doBranch(br_target);
}

:end is opc=0x0b; ctx_is_return=1; ctx_is_directive=0 {
	nop();
	callEpilogueCallOther(&o0);
	return [LR];
}
:end is opc=0x0b; ctx_is_return=0; ctx_is_directive=0 {
}

:br br_target is opc=0x0c; ULeb128; br_target; ctx_is_directive=0 {
	doBranch(br_target);
}
:br_if br_target is opc=0x0d; ULeb128; br_target; sp1_32; ctx_is_directive=0 {
	if(sp1_32 == 0) goto inst_next;
	doBranch(br_target);
}

:.case ctx_case_index br_target is ULeb128; br_target; ctx_case_index; ctx_is_directive=1; ctx_directive_type=$(DIRECTIVE_CASE) {
	if(BRTableInput != ctx_case_index) goto inst_next;
	doBranch(br_target);
}

# @@BRTABLE_CAP: past the per-br_table cap on modelled *case* targets (MAX_BR_TABLE_CASES-1),
# the remaining case labels are consumed by this byte-only directive. It keeps the byte stream
# aligned (no undefined bytes) but contributes no pcode and no basic block, so a pathological
# br_table (the spec suite's br_table.wast `large`, ~16k labels) cannot explode the decompiler's
# control-flow graph. The default target is never routed here - it is always modelled as a
# `.default` directive. The pre-analyzer emits it from setBrTableCaseIgnored();
# DIRECTIVE_CASE_IGNORED must stay in sync with ContextRegister.DIRECTIVE_CASE_IGNORED in
# wasm/analysis/WasmFunctionAnalysis.java.
:.case_ignored is ULeb128; ctx_is_directive=1; ctx_directive_type=$(DIRECTIVE_CASE_IGNORED) {
}

:.default br_target is ULeb128; br_target; ctx_is_directive=1; ctx_directive_type=$(DIRECTIVE_DEFAULT) {
	doBranch(br_target);
}

:br_table is opc=0x0e; ULeb128; sp1_32; ctx_is_directive=0 {
	BRTableInput = sp1_32;
}

:return is opc=0x0f; ctx_is_directive=0 {
	nop();
	callEpilogueCallOther(&o0);
	return [LR];
}
# note: anything following the call doesn't happen in emulation mode
# the movement of outputs is handled by callEpilogueCallOther in emulation mode
:call br_target is opc=0x10; ULeb128; br_target; ctx_is_directive=0 {
	LR = inst_next;
	callPrologueCallOther(&i0);
	call br_target;
	pushCallOther(&o0);
}
:call_indirect "type="^typeidx tableref is opc=0x11; typeidx; tableref; sp1_32; ctx_table64=0; ctx_is_directive=0 {
	addr:8 = &tableref + zext(sp1_32) * 4;
	val:4 = *[table] addr;
	LR = inst_next;
	callPrologueCallOther(&i0);
	call [val];
	pushCallOther(&o0);
}

## Tail calls: call, then return what the callee returned (its outputs are already in the output registers)
:return_call br_target is opc=0x12; ULeb128; br_target; ctx_is_directive=0 {
	LR = inst_next;
	callPrologueCallOther(&i0);
	call br_target;
	return [LR];
}
:return_call_indirect "type="^typeidx tableref is opc=0x13; typeidx; tableref; sp1_32; ctx_table64=0; ctx_is_directive=0 {
	addr:8 = &tableref + zext(sp1_32) * 4;
	val:4 = *[table] addr;
	LR = inst_next;
	callPrologueCallOther(&i0);
	call [val];
	return [LR];
}

# @@FR: typed function references (proposal: function-references). Like call_indirect, the
# function reference is the top operand-stack value when the instruction executes (the call
# arguments sit below it), so it is read from stack slot ctx_sp-1 and the call is indirect
# through it. When the reference came from ref.func or a table element the loader has already
# resolved it to a function address, so the decompiler shows a real call through a known
# address. The concrete referenced type $t is not modelled (see ValType.readFromReader, which
# folds (ref null $t)/(ref $t) onto a 4-byte reference placeholder); the argument/return
# widths come from the injected call prologue/epilogue.
:call_ref "type="^typeidx is opc=0x14; typeidx; sp1_32; ctx_is_directive=0 {
	ref_target:4 = sp1_32;
	LR = inst_next;
	callPrologueCallOther(&i0);
	call [ref_target];
	pushCallOther(&o0);
}
:return_call_ref "type="^typeidx is opc=0x15; typeidx; sp1_32; ctx_is_directive=0 {
	ref_target:4 = sp1_32;
	LR = inst_next;
	callPrologueCallOther(&i0);
	call [ref_target];
	return [LR];
}

## Legacy exception handling (try / catch / catch_all / throw / rethrow / delegate). A try is a block; when it has a
## handler (ctx_case_index=1, set by the pre-analyzer) it also dispatches to its FIRST handler on
## wasm_exception_caught(), passing the exception's payload when it is a single value (ctx_operand_size). Later
## handlers are reached only by exceptions, so the decompiler does not show them. catch/catch_all end the preceding
## code with a branch to the end of the try, like else.
:try "blocktype="^ULeb128 is opc=0x06; ULeb128; ctx_case_index=0; ctx_is_directive=0 {
}
:try "blocktype="^ULeb128 br_target is opc=0x06; ULeb128; br_target; ctx_case_index=1; ctx_operand_size=0; ctx_is_directive=0 {
	nop();
	local caught:1 = wasm_exception_caught();
	if (caught == 0) goto inst_next;
	goto br_target;
}
:try "blocktype="^ULeb128 br_target is opc=0x06; ULeb128; br_target; sp0_32; ctx_case_index=1; ctx_operand_size=4; ctx_is_directive=0 {
	nop();
	local caught:1 = wasm_exception_caught();
	if (caught == 0) goto inst_next;
	sp0_32 = wasm_exception_payload();
	goto br_target;
}
:try "blocktype="^ULeb128 br_target is opc=0x06; ULeb128; br_target; sp0_64; ctx_case_index=1; ctx_operand_size=8; ctx_is_directive=0 {
	nop();
	local caught:1 = wasm_exception_caught();
	if (caught == 0) goto inst_next;
	sp0_64 = wasm_exception_payload();
	goto br_target;
}
:catch "tag="^ULeb128 br_target is opc=0x07; ULeb128; br_target; ctx_is_directive=0 {
	doBranch(br_target);
}
:catch_all br_target is opc=0x19; br_target; ctx_is_directive=0 {
	doBranch(br_target);
}
:throw "tag="^ULeb128 is opc=0x08; ULeb128; ctx_operand_size=0; ctx_is_directive=0 {
	wasm_throw(ULeb128:4);
	trap();
}
:throw "tag="^ULeb128 is opc=0x08; ULeb128; sp1_32; ctx_operand_size=4; ctx_is_directive=0 {
	wasm_throw(ULeb128:4, sp1_32);
	trap();
}
:throw "tag="^ULeb128 is opc=0x08; ULeb128; sp1_64; ctx_operand_size=8; ctx_is_directive=0 {
	wasm_throw(ULeb128:4, sp1_64);
	trap();
}
:rethrow ULeb128 is opc=0x09; ULeb128; ctx_is_directive=0 {
	wasm_rethrow(ULeb128:4);
	trap();
}
:delegate ULeb128 is opc=0x18; ULeb128; ctx_is_directive=0 {
}

# @@TRY_MULTIBYTE: multi-byte block signatures for legacy try (0x06).
# The plain ULeb128 forms above consume only the first byte of a (ref null ht)/(ref ht) valtype
# or a multi-byte s33 type index, desynchronising the body. Add explicit multi-byte forms.
:try "blocktype="^multi_blocktype is opc=0x06; multi_blocktype; ctx_case_index=0; ctx_is_directive=0 {
}
:try "blocktype="^multi_blocktype br_target is opc=0x06; multi_blocktype; br_target; ctx_case_index=1; ctx_operand_size=0; ctx_is_directive=0 {
	nop();
	local caught:1 = wasm_exception_caught();
	if (caught == 0) goto inst_next;
	goto br_target;
}
:try "blocktype="^multi_blocktype br_target is opc=0x06; multi_blocktype; br_target; sp0_32; ctx_case_index=1; ctx_operand_size=4; ctx_is_directive=0 {
	nop();
	local caught:1 = wasm_exception_caught();
	if (caught == 0) goto inst_next;
	sp0_32 = wasm_exception_payload();
	goto br_target;
}
:try "blocktype="^multi_blocktype br_target is opc=0x06; multi_blocktype; br_target; sp0_64; ctx_case_index=1; ctx_operand_size=8; ctx_is_directive=0 {
	nop();
	local caught:1 = wasm_exception_caught();
	if (caught == 0) goto inst_next;
	sp0_64 = wasm_exception_payload();
	goto br_target;
}

## Reference Instructions
# @@FR: ref.null's immediate is an s33 heap type (abstract types are the negative values
# -0x10..-0x0c, concrete type indices are >= 0). The previous `valtype` operand is restricted
# to the *named* abstract heap types (0x69..0x74) by its names table, so a concrete type index
# (e.g. `ref.null 0`) had no matching name and its bytes were left undefined. This operand
# accepts any s33. (The abstract types therefore print as their numeric heap-type value.)
#
# @@REFNULL-NAMES (Mistral Large 4): named constructors per abstract heap type byte, alongside
# the generic s33 form. The Wasm 3.0 spec binary encoding (verified against
# https://webassembly.github.io/spec/core/binary/types.html) maps:
#   0x69=exn  0x6A=array  0x6B=struct  0x6C=i31  0x6D=eq  0x6E=any  0x6F=extern
#   0x70=func  0x71=none  0x72=noextern  0x73=nofunc  0x74=noexn
# Each named variant constrains all 8 bits of the byte (bytev=0xNN), making it strictly more
# specific than the generic single-byte SLeb128 variant (which constrains only bit 7 via
# topbit=0), so SLEIGH's pattern disambiguation prefers the named constructor. Concrete type
# indices (>= 0, possibly multi-byte s33) still decode via the generic path below,
# byte-identically (the s33 fallback for concrete type indices is unchanged).
ref_null_ht_named: "exn" is bytev=0x69 { }
ref_null_ht_named: "array" is bytev=0x6a { }
ref_null_ht_named: "struct" is bytev=0x6b { }
ref_null_ht_named: "i31" is bytev=0x6c { }
ref_null_ht_named: "eq" is bytev=0x6d { }
ref_null_ht_named: "any" is bytev=0x6e { }
ref_null_ht_named: "extern" is bytev=0x6f { }
ref_null_ht_named: "func" is bytev=0x70 { }
ref_null_ht_named: "none" is bytev=0x71 { }
ref_null_ht_named: "noextern" is bytev=0x72 { }
ref_null_ht_named: "nofunc" is bytev=0x73 { }
ref_null_ht_named: "noexn" is bytev=0x74 { }

ref_null_ht: SLeb128 is SLeb128 {
	export SLeb128;
}

:ref.null ref_null_ht_named is opc=0xd0; ref_null_ht_named; sp0_32; ctx_is_directive=0 {
	sp0_32 = 0;
}
:ref.null "heaptype="^ref_null_ht is opc=0xd0; ref_null_ht; sp0_32; ctx_is_directive=0 {
	sp0_32 = 0;
}
:ref.is_null is opc=0xd1; sp1_32; ctx_is_directive=0 {
	res:4 = zext(sp1_32 == 0);
	sp1_32 = res;
}
:ref.func br_target is opc=0xd2; funcidx; br_target; sp0_32; ctx_is_directive=0 {
	sp0_32 = &br_target;
}

# @@FR: function-references reference instructions. ValType carries no nullability, so
# ref.as_non_null is a width-preserving identity (the value stays in the same stack slot).
:ref.as_non_null is opc=0xd4; sp1_32; ctx_is_directive=0 {
	ref_value:4 = sp1_32;
	sp1_32 = ref_value;
}

# br_on_null: branch if the reference is null; the fall-through direction keeps the
# (now non-null) reference on the operand stack.
:br_on_null br_target is opc=0xd5; ULeb128; br_target; sp1_32; ctx_is_directive=0 {
	nop();
	if (sp1_32 != 0) goto inst_next;
	doBranch(br_target);
}

# br_on_non_null: branch if the reference is non-null (passing it on to the target);
# the fall-through direction consumes the null reference.
:br_on_non_null br_target is opc=0xd6; ULeb128; br_target; sp1_32; ctx_is_directive=0 {
	nop();
	if (sp1_32 == 0) goto inst_next;
	doBranch(br_target);
}

## Parametric Instructions
:drop is opc=0x1a; ctx_is_directive=0 {
	# stack adjustment is handled by preanalyzer
}

macro select32(sp1_32, sp2_32, sp3_32) {
	if (sp1_32 != 0) goto inst_next;
	sp3_32 = sp2_32;
}

macro select64(sp1_32, sp2_64, sp3_64) {
	if (sp1_32 != 0) goto inst_next;
	sp3_64 = sp2_64;
}

macro select128(sp1_32, sp2_128, sp3_128) {
	if (sp1_32 != 0) goto inst_next;
	sp3_128 = sp2_128;
}

:select is opc=0x1b; sp1_32; sp2_32; sp3_32; ctx_is_directive=0; ctx_operand_size=4 {
	select32(sp1_32, sp2_32, sp3_32);
}
:select is opc=0x1b; sp1_32; sp2_64; sp3_64; ctx_is_directive=0; ctx_operand_size=8 {
	select64(sp1_32, sp2_64, sp3_64);
}
:select is opc=0x1b; sp1_32; sp2_128; sp3_128; ctx_is_directive=0; ctx_operand_size=16 {
	select128(sp1_32, sp2_128, sp3_128);
}

# In the current version of Wasm, only one type index is permitted in select t*.
# This is functionally identical to regular select.
select_valtype: valtype is valtype; sp1_32; sp2_32; sp3_32 {
	# i32, f32, funcref, externref
	select32(sp1_32, sp2_32, sp3_32);
}
select_valtype: valtype is valtype & (bytev=0x7e | bytev=0x7c); sp1_32; sp2_64; sp3_64 {
	# i64, f64
	select64(sp1_32, sp2_64, sp3_64);
}
select_valtype: valtype is valtype & bytev=0x7b; sp1_32; sp2_128; sp3_128 {
	# v128
	select128(sp1_32, sp2_128, sp3_128);
}

# opc2_1 is used here to check that the LEB128 length of the type vector is 1.
select_valtype: local_reftype is local_reftype; sp1_32; sp2_32; sp3_32 {
	select32(sp1_32, sp2_32, sp3_32);
}

:select select_valtype is opc=0x1c; opc2_1; select_valtype; ctx_is_directive=0 {
}

## Variable Instructions
:local.get local4 is opc=0x20; local4; sp0_32; ctx_is_directive=0; ctx_operand_size=4 {
	sp0_32 = local4;
}
:local.get local8 is opc=0x20; local8; sp0_64; ctx_is_directive=0; ctx_operand_size=8 {
	sp0_64 = local8;
}
:local.get local16 is opc=0x20; local16; sp0_128; ctx_is_directive=0; ctx_operand_size=16 {
	sp0_128 = local16;
}

:local.set local4 is opc=0x21; local4; sp1_32; ctx_is_directive=0; ctx_operand_size=4 {
	local4 = sp1_32;
}
:local.set local8 is opc=0x21; local8; sp1_64; ctx_is_directive=0; ctx_operand_size=8 {
	local8 = sp1_64;
}
:local.set local16 is opc=0x21; local16; sp1_128; ctx_is_directive=0; ctx_operand_size=16 {
	local16 = sp1_128;
}

:local.tee local4 is opc=0x22; local4; sp1_32; ctx_is_directive=0; ctx_operand_size=4 {
	local4 = sp1_32;
}
:local.tee local8 is opc=0x22; local8; sp1_64; ctx_is_directive=0; ctx_operand_size=8 {
	local8 = sp1_64;
}
:local.tee local16 is opc=0x22; local16; sp1_128; ctx_is_directive=0; ctx_operand_size=16 {
	local16 = sp1_128;
}

:global.get global4 is opc=0x23; global4; sp0_32; ctx_is_directive=0; ctx_operand_size=4; ctx_is_global_sp=0 {
	sp0_32 = global4;
}
:global.get global4 is opc=0x23; global4; sp0_32; ctx_is_directive=0; ctx_operand_size=4; ctx_is_global_sp=1 {
	sp0_32 = SP;
}
:global.get global8 is opc=0x23; global8; sp0_64; ctx_is_directive=0; ctx_operand_size=8 {
	sp0_64 = global8;
}
:global.get global16 is opc=0x23; global16; sp0_128; ctx_is_directive=0; ctx_operand_size=16 {
	sp0_128 = global16;
}

:global.set global4 is opc=0x24; global4; sp1_32; ctx_is_directive=0; ctx_operand_size=4; ctx_is_global_sp=0 {
	global4 = sp1_32;
}
:global.set global4 is opc=0x24; global4; sp1_32; ctx_is_directive=0; ctx_operand_size=4; ctx_is_global_sp=1 {
	SP = sp1_32;
}
:global.set global8 is opc=0x24; global8; sp1_64; ctx_is_directive=0; ctx_operand_size=8 {
	global8 = sp1_64;
}
:global.set global16 is opc=0x24; global16; sp1_128; ctx_is_directive=0; ctx_operand_size=16 {
	global16 = sp1_128;
}

## Table Instructions
:table.get tableref is opc=0x25; tableref; sp1_32; ctx_table64=0; ctx_is_directive=0 {
	addr:8 = &tableref + zext(sp1_32) * 4;
	sp1_32 = *[table] addr;
}

:table.set tableref is opc=0x26; tableref; sp1_32; sp2_32; ctx_table64=0; ctx_is_directive=0 {
	addr:8 = &tableref + zext(sp2_32) * 4;
	*[table] addr = sp1_32;
}

:table.init elemidx tableidx is opc=0xfc; opc2_12; elemidx; tableidx; sp1_32; sp2_32; sp3_32; ctx_table64=0; ctx_is_directive=0 {
	table_init(elemidx:4, tableidx:4, sp1_32, sp2_32, sp3_32);
}

:elem.drop elemidx is opc=0xfc; opc2_13; elemidx; ctx_is_directive=0 {
	elem_drop(elemidx:4);
}

:table.copy tableidx tableidx2 is opc=0xfc; opc2_14; tableidx; tableidx2; sp1_32; sp2_32; sp3_32; ctx_table64=0; ctx_is_directive=0 {
	table_copy(tableidx:4, tableidx2:4, sp1_32, sp2_32, sp3_32);
}

:table.grow tableidx is opc=0xfc; opc2_15; tableidx; sp1_32; sp2_32; ctx_table64=0; ctx_is_directive=0 {
	sp2_32 = table_grow(tableidx:4, sp2_32, sp1_32);
}

:table.size tableidx is opc=0xfc; opc2_16; tableidx; sp0_32; ctx_table64=0; ctx_is_directive=0 {
	sp0_32 = table_size(tableidx:4);
}

:table.fill tableidx is opc=0xfc; opc2_17; tableidx; sp1_32; sp2_32; sp3_32; ctx_table64=0; ctx_is_directive=0 {
	table_fill(tableidx:4, sp1_32, sp2_32, sp3_32);
}


## Memory Instructions
## @@M64: two variants per instruction, selected by ctx_mem64 (see WebAssembly.slaspec and the
## @@M64 block in WasmFunctionAnalysis.java): the plain form is the historical 32-bit-index
## form (used by every 32-bit memory, byte for byte unchanged), the " (i64 index)" form is a
## 64-bit-index (memory64) form whose address/offset operands are i64. The operands are typed
## exactly as the core spec's validation rules require (load/store [at]->[t], memory.size
## []->[at], memory.grow [at]->[at], memory.fill [at i32 at], memory.init [at i32 i32],
## memory.copy x1 x2 [at1 at2 min(at1,at2)]).
:memory.size memidx is opc=0x3f; memidx; ctx_mem64=0; sp0_32; ctx_is_directive=0 {
	sp0_32 = memory_size(memidx:4);
}

:memory.size memidx " (i64 index)" is opc=0x3f; memidx; ctx_mem64=3; sp0_64; ctx_is_directive=0 {
	sp0_64 = memory_size(memidx:4);
}

:memory.grow memidx is opc=0x40; memidx; ctx_mem64=0; sp1_32; ctx_is_directive=0 {
	sp1_32 = memory_grow(memidx:4, sp1_32);
}

:memory.grow memidx " (i64 index)" is opc=0x40; memidx; ctx_mem64=3; sp1_64; ctx_is_directive=0 {
	sp1_64 = memory_grow(memidx:4, sp1_64);
}

:memory.init dataidx memidx is opc=0xfc; opc2_8; dataidx; memidx; ctx_mem64=0; sp1_32; sp2_32; sp3_32; ctx_is_directive=0 {
	memory_init(dataidx, memidx:4, sp1_32, sp2_32, sp3_32);
}

## @@M64: [at i32 i32] - only the destination offset is i64.
:memory.init dataidx memidx " (i64 index)" is opc=0xfc; opc2_8; dataidx; memidx; ctx_mem64=3; sp1_32; sp2_32; sp3_64; ctx_is_directive=0 {
	memory_init(dataidx, memidx:4, sp1_32, sp2_32, sp3_64);
}

:data.drop dataidx is opc=0xfc; opc2_9; dataidx; ctx_is_directive=0 {
	data_drop(dataidx);
}

:memory.copy memidx memidx2 is opc=0xfc; opc2_10; memidx; memidx2; ctx_mem64=0; sp1_32; sp2_32; sp3_32; ctx_is_directive=0 {
	memory_copy(memidx:4, memidx2:4, sp1_32, sp2_32, sp3_32);
}

## @@M64: memory.copy x1 x2: [at1(dst) at2(src) min(at1,at2)(len)], one variant per width pair.
:memory.copy memidx memidx2 " (i64 dst)" is opc=0xfc; opc2_10; memidx; memidx2; ctx_mem64=1; sp1_32; sp2_32; sp3_64; ctx_is_directive=0 {
	memory_copy(memidx:4, memidx2:4, sp1_32, sp2_32, sp3_64);
}

:memory.copy memidx memidx2 " (i64 src)" is opc=0xfc; opc2_10; memidx; memidx2; ctx_mem64=2; sp1_32; sp2_64; sp3_32; ctx_is_directive=0 {
	memory_copy(memidx:4, memidx2:4, sp1_32, sp2_64, sp3_32);
}

:memory.copy memidx memidx2 " (i64 index)" is opc=0xfc; opc2_10; memidx; memidx2; ctx_mem64=3; sp1_64; sp2_64; sp3_64; ctx_is_directive=0 {
	memory_copy(memidx:4, memidx2:4, sp1_64, sp2_64, sp3_64);
}

:memory.fill memidx is opc=0xfc; opc2_11; memidx; ctx_mem64=0; sp1_32; sp2_32; sp3_32; ctx_is_directive=0 {
	memory_fill(memidx:4, sp1_32, sp2_32, sp3_32);
}

## @@M64: [at(dst) i32(value) at(len)].
:memory.fill memidx " (i64 index)" is opc=0xfc; opc2_11; memidx; ctx_mem64=3; sp1_64; sp2_32; sp3_64; ctx_is_directive=0 {
	memory_fill(memidx:4, sp1_64, sp2_32, sp3_64);
}

## Numeric Instructions: const
:i32.const SLeb128 is opc=0x41; SLeb128; sp0_32; ctx_is_directive=0 {
	sp0_32 = SLeb128:4;
}

:i64.const SLeb128 is opc=0x42; SLeb128; sp0_64; ctx_is_directive=0 {
	sp0_64 = SLeb128:8;
}

:f32.const f32 is opc=0x43; f32; sp0_32; ctx_is_directive=0 {
	sp0_32 = f32:4;
}

:f64.const f64 is opc=0x44; f64; sp0_64; ctx_is_directive=0 {
	sp0_64 = f64:8;
}

# @@SS/@@STR/@@WA begin ----------------------------------------------------------------
# Operands shared by the stack-switching / JS-string-builtins / wide-arithmetic instructions
# (the instructions themselves live in StackSwitchOps.sinc, StringOps.sinc and
# WideArithOps.sinc, all included at the bottom of this file).
#
# The graceful-degradation fallback (:unimplemented) still exists for opcodes that are not
# modelled: 0xE7+ (unassigned stack switching), unassigned 0xFB >= 0x80 sub-opcodes, and the
# unassigned 0xFC sub-opcodes. There the instruction is rendered visibly incomplete instead of
# being silently wrong, and the pre-analyzer mirrors the operand lengths in
# wasm/analysis/WasmFunctionAnalysis.java.
stringidx: "string="^ULeb128 is ULeb128 {
	export ULeb128;
}
# @@SS/@@STR/@@WA end

@include "BasicOps.sinc"
@include "VectorOps.sinc"
@include "AtomicOps.sinc"
@include "RelaxedSimdOps.sinc"
@include "EH2Ops.sinc"   # @@EH: new exception handling (try_table, throw_ref)
@include "GCOps.sinc"    # @@GC: garbage collection opcodes (0xFB)
@include "StackSwitchOps.sinc"  # @@SS: stack switching / JSPI (0xE0-0xE6)
@include "WideArithOps.sinc"    # @@WA: wide arithmetic + memory.discard (0xFC 0x12-0x16)
@include "StringOps.sinc"       # @@STR: JS string builtins / stringref (0xFB 0x80-0xB7)

# Table64 index widths, including mixed-width table.copy.
:call_indirect "type="^typeidx tableref is opc=0x11; typeidx; tableref; sp1_64; ctx_table64=3; ctx_is_directive=0 {
	addr:8 = &tableref + sp1_64 * 4;
	val:4 = *[table] addr;
	LR = inst_next;
	callPrologueCallOther(&i0);
	call [val];
	pushCallOther(&o0);
}

:return_call_indirect "type="^typeidx tableref is opc=0x13; typeidx; tableref; sp1_64; ctx_table64=3; ctx_is_directive=0 {
	addr:8 = &tableref + sp1_64 * 4;
	val:4 = *[table] addr;
	LR = inst_next;
	callPrologueCallOther(&i0);
	call [val];
	return [LR];
}

:table.get tableref is opc=0x25; tableref; sp1_64; sp1_32; ctx_table64=3; ctx_is_directive=0 {
	addr:8 = &tableref + sp1_64 * 4;
	sp1_32 = *[table] addr;
}

:table.set tableref is opc=0x26; tableref; sp1_32; sp2_64; ctx_table64=3; ctx_is_directive=0 {
	addr:8 = &tableref + sp2_64 * 4;
	*[table] addr = sp1_32;
}

:table.init elemidx tableidx is opc=0xfc; opc2_12; elemidx; tableidx; sp1_32; sp2_32; sp3_64; ctx_table64=3; ctx_is_directive=0 {
	table_init(elemidx:4, tableidx:4, sp1_32, sp2_32, sp3_64);
}

:table.copy tableidx tableidx2 is opc=0xfc; opc2_14; tableidx; tableidx2; sp1_32; sp2_32; sp3_64; ctx_table64=1; ctx_is_directive=0 {
	table_copy(tableidx:4, tableidx2:4, sp1_32, sp2_32, sp3_64);
}

:table.copy tableidx tableidx2 is opc=0xfc; opc2_14; tableidx; tableidx2; sp1_32; sp2_64; sp3_32; ctx_table64=2; ctx_is_directive=0 {
	table_copy(tableidx:4, tableidx2:4, sp1_32, sp2_64, sp3_32);
}

:table.copy tableidx tableidx2 is opc=0xfc; opc2_14; tableidx; tableidx2; sp1_64; sp2_64; sp3_64; ctx_table64=3; ctx_is_directive=0 {
	table_copy(tableidx:4, tableidx2:4, sp1_64, sp2_64, sp3_64);
}

:table.grow tableidx is opc=0xfc; opc2_15; tableidx; sp1_64; sp2_64; sp2_32; ctx_table64=3; ctx_is_directive=0 {
	sp2_64 = table_grow(tableidx:4, sp2_32, sp1_64);
}

:table.size tableidx is opc=0xfc; opc2_16; tableidx; sp0_64; ctx_table64=3; ctx_is_directive=0 {
	sp0_64 = table_size(tableidx:4);
}

:table.fill tableidx is opc=0xfc; opc2_17; tableidx; sp1_64; sp2_32; sp3_64; ctx_table64=3; ctx_is_directive=0 {
	table_fill(tableidx:4, sp1_64, sp2_32, sp3_64);
}
