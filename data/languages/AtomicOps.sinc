# Threads proposal: atomic memory instructions (0xFE prefix). Added for wasm-ghidra; generated.
# Atomicity does not matter to the decompiler: loads and stores are plain memory accesses, read-modify-write returns
# the old value, cmpxchg stores only when the old value equals the expected one. wait/notify are callothers.

## 32-bit memory: 32-bit address arithmetic (addr:4, no ZEXT — see BasicOps.sinc).
atomicaddr3: memalign memoffset is memalign; memoffset; ctx_mem64=0; sp3_32 {
	addr:4 = memoffset:4 + sp3_32;
	export addr;
}

## @@MM: memarg carrying a memory index (see BasicOps.sinc)
atomicaddr3: memalign_mem memidx_label memoffset is memalign_mem; memidx_label; memoffset; ctx_mem64=0; sp3_32 {
	addr:4 = memoffset:4 + sp3_32 + memidx_label:4 * $(MEMORY_STRIDE);
	export addr;
}

## @@M64: 64-bit-indexed memory (see the loadaddr note in BasicOps.sinc).
atomicaddr3_64: memalign memoffset " (i64 index)" is memalign; memoffset; ctx_mem64=3; sp3_64 {
	addr:8 = memoffset:8 + sp3_64;
	export addr;
}

atomicaddr3_64: memalign_mem memidx_label memoffset " (i64 index)" is memalign_mem; memidx_label; memoffset; ctx_mem64=3; sp3_64 {
	addr:8 = memoffset:8 + sp3_64 + memidx_label:8 * $(MEMORY_STRIDE);
	export addr;
}

:memory.atomic.notify storeaddr is opc=0xFE; opc2_0; storeaddr; sp1_32; sp2_32; ctx_mem64=0; ctx_is_directive=0 {
	sp2_32 = memory_atomic_notify(storeaddr, sp1_32);
}
:memory.atomic.notify storeaddr64 is opc=0xFE; opc2_0; storeaddr64; sp1_32; sp2_32; ctx_mem64=3; ctx_is_directive=0 {
